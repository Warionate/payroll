# Server Configuration
PORT=4001

# Security (REQUIRED - app will not start without these)
# 32-character random string for AES-256 encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=

# Secret key for JWT signing (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Push Notifications (VAPID Keys)
# Generate using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Discord Webhook (optional)
# DISCORD_WEBHOOK_URL は全カテゴリの fallback。カテゴリごとに分けたい場合は
# 個別に設定するとそちらが優先される。すべて未設定なら通知は送らない。
DISCORD_WEBHOOK_URL=
DISCORD_REGISTER_WEBHOOK_URL=
DISCORD_SECURITY_WEBHOOK_URL=
DISCORD_ERROR_WEBHOOK_URL=
DISCORD_OPS_WEBHOOK_URL=
DISCORD_ADMIN_WEBHOOK_URL=
