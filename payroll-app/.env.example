# Server Configuration
PORT=4001

# Security (REQUIRED - app will not start without these)
# 32-character random string for AES-256 encryption
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=

# Secret key for JWT signing (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# パスキーの user handle を作る鍵（optional・32 文字以上推奨）。JWT_SECRET と分けておくと、
# JWT_SECRET を入れ替えても user handle が変わらない。未設定なら JWT_SECRET を使う。
# 既存の環境で後から設定するときは、今の JWT_SECRET と同じ値を入れる（既存の user handle を保つ）
WEBAUTHN_USER_HANDLE_SECRET=

# Push Notifications (VAPID Keys)
# Generate using: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Discord Webhook (optional)
# DISCORD_WEBHOOK_URL は全カテゴリの fallback。カテゴリごとに分けたい場合は
# 個別に設定するとそちらが優先される。すべて未設定なら通知は送らない。
DISCORD_WEBHOOK_URL=
DISCORD_REGISTER_WEBHOOK_URL=
DISCORD_SECURITY_WEBHOOK_URL=
DISCORD_ERROR_WEBHOOK_URL=
DISCORD_OPS_WEBHOOK_URL=
DISCORD_ADMIN_WEBHOOK_URL=

# 管理者のログイン（optional）
# 管理者はパスワードだけではログインできない（パスキーか Authentik が必須）。
# パスキーも Authentik も使えなくなって締め出されたときだけ allow にする（非常口。戻したら消す）
# ADMIN_PASSWORD_LOGIN=allow

# 最初の設定の強制（optional）
# 確認済みのメール・二段階認証・ルールに合うユーザー ID が揃うまでアプリを使わせない。既定は強制。
# 一時的に外すときだけ off にする（テストでは自動的に外れる）
# ACCOUNT_SETUP_REQUIRED=off

# 漏洩済みパスワードの照合（optional）
# 登録・変更・再設定のときに Have I Been Pwned（api.pwnedpasswords.com）に問い合わせる。
# 外に出るのは SHA-1 の先頭 5 文字だけ。外への通信ができない環境では off にする
# PWNED_CHECK=off
