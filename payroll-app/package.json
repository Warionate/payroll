{
  "name": "tutoring-payroll-app-root",
  "version": "8.2.1",
  "description": "Root for Individual Tutoring Payroll Calculator",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "workspaces": [
    "packages/shared",
    "server",
    "client"
  ],
  "scripts": {
    "start": "npm run start --workspace=server",
    "dev": "npm run dev --workspace=server",
    "build:shared": "npm run build --workspace=@payroll/shared",
    "build": "npm run build:shared && npm run build --workspace=client",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "bump": "npm version --workspaces --include-workspace-root --no-git-tag-version",
    "audit:prod": "npm audit --omit=dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    },
    "filelist": {
      "minimatch": "^10.2.5"
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.60.1",
    "@rollup/rollup-linux-x64-musl": "4.60.1",
    "@rollup/rollup-linux-arm64-gnu": "4.60.1",
    "@rollup/rollup-linux-arm64-musl": "4.60.1",
    "@rollup/rollup-darwin-x64": "4.60.1",
    "@rollup/rollup-darwin-arm64": "4.60.1",
    "@img/sharp-linux-x64": "0.35.3",
    "@img/sharp-linux-arm64": "0.35.3",
    "@img/sharp-linuxmusl-x64": "0.35.3",
    "@img/sharp-linuxmusl-arm64": "0.35.3",
    "@img/sharp-libvips-linux-x64": "1.3.2",
    "@img/sharp-libvips-linux-arm64": "1.3.2",
    "@img/sharp-libvips-linuxmusl-x64": "1.3.2",
    "@img/sharp-libvips-linuxmusl-arm64": "1.3.2",
    "@img/sharp-darwin-x64": "0.35.3",
    "@img/sharp-darwin-arm64": "0.35.3",
    "@img/sharp-libvips-darwin-x64": "1.3.2",
    "@img/sharp-libvips-darwin-arm64": "1.3.2",
    "@esbuild/linux-x64": "0.28.1",
    "@esbuild/linux-arm64": "0.28.1",
    "@esbuild/linux-arm": "0.28.1",
    "@esbuild/darwin-x64": "0.28.1",
    "@esbuild/darwin-arm64": "0.28.1",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-arm64-musl": "4.3.3",
    "@tailwindcss/oxide-darwin-x64": "4.3.3",
    "@tailwindcss/oxide-darwin-arm64": "4.3.3"
  },
  "allowScripts": {
    "bcrypt": true,
    "better-sqlite3@12.11.1": true,
    "esbuild": true,
    "@scarf/scarf": false
  }
}
