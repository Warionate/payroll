NODE_ENV=development
PORT=4002

# 開発時のみ: localhost から直接開いた管理画面を Cloudflare Access なしで許可する。
# NODE_ENV=production では無効。Cloudflare 経由のアクセスにも効かない。
ADMIN_DEV_BYPASS=true

# 監視対象
PAYROLL_URL=https://payroll.warionate.com
HEALTH_CHECK_INTERVAL_MS=30000
HEALTH_CHECK_TIMEOUT_MS=10000
HEALTH_CHECK_RETRIES=2
HEALTH_CHECK_RETRY_DELAY_MS=2000
CONSECUTIVE_FAILURES_THRESHOLD=3
RECOVERY_SUCCESS_THRESHOLD=2
# 監視側のネットワーク不調を切り分けるための対照 URL（空で無効）
HEALTH_CHECK_CONTROL_URL=https://www.cloudflare.com/cdn-cgi/trace

# Discord Bot
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_OWNER_ID=

# Discord Webhook (障害通知用)
DISCORD_WEBHOOK_URL=

# リダイレクト先
REDIRECT_URL=https://payroll.warionate.com

# Cloudflare Access (admin パネル保護用)
CF_ACCESS_TEAM_DOMAIN=warionate.cloudflareaccess.com
CF_ACCESS_AUD=
